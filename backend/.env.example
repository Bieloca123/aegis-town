FRONTEND_URL=http://localhost:3000
SUPABASE_URL=
SERVICE_ROLE=
PORT=3001

# Shared secret expected as `Authorization: Bearer <secret>` on POST /webhooks/notify.
# Used by n8n / external automations to push toast notifications to Aegis users.
NOTIFICATION_WEBHOOK_SECRET=

# ClickUp workspace API token + team id, used by /clickup/members + /clickup/link
# to fetch the agency's roster and validate identity-link requests, and by
# /webhooks/clickup to look up task names/urls for incoming events.
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# Per-webhook secret returned by ClickUp at registration time. Used by
# /webhooks/clickup to verify the X-Signature header (HMAC-SHA256 of body).
# To obtain: run `npx ts-node backend/scripts/register-clickup-webhook.ts register <public-url>`.
CLICKUP_WEBHOOK_SECRET=
